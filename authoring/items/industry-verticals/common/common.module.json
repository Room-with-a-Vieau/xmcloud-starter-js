{
  "$schema": "../../../../.sitecore/schemas/ModuleFile.schema.json",
  "namespace": "Project.IndustryVerticals",
  "description": "Shared schema for the FY27 industry-verticals tenant (templates, renderings, placeholders, branches) plus the nova-medical site root. Trimmed from Room-with-a-Vieau/FY27-verticals to the healthcare site only.",
  "references": [
    "system"
  ],
  "items": {
    "includes": [
      {
        "name": "module",
        "path": "/sitecore/system/settings/Project/industry-verticals",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "templatesProject",
        "path": "/sitecore/templates/Project/industry-verticals",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "branchesProject",
        "path": "/sitecore/templates/Branches/Project/industry-verticals",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "projectMediaFolders",
        "path": "/sitecore/Media Library/Project/industry-verticals",
        "rules": [
          {
            "path": "/shared",
            "scope": "SingleItem",
            "allowedPushOperations": "CreateOnly"
          },
          {
            "path": "/nova-medical",
            "scope": "SingleItem",
            "allowedPushOperations": "CreateOnly"
          }
        ]
      },
      {
        "name": "projectRenderings",
        "path": "/sitecore/Layout/Renderings/Project/industry-verticals",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "projectPlaceholderSettings",
        "path": "/sitecore/Layout/Placeholder Settings/Project/industry-verticals",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "tenantRoot",
        "path": "/sitecore/content/industry-verticals",
        "scope": "SingleItem",
        "allowedPushOperations": "CreateAndUpdate"
      },
      {
        "name": "sites-nova-medical",
        "path": "/sitecore/content/industry-verticals/nova-medical",
        "rules": [
          {
            "path": "/home",
            "scope": "SingleItem",
            "allowedPushOperations": "CreateOnly"
          },
          {
            "path": "/Media",
            "scope": "SingleItem",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Data",
            "scope": "SingleItem",
            "allowedPushOperations": "CreateOnly"
          },
          {
            "path": "/Dictionary",
            "scope": "SingleItem",
            "allowedPushOperations": "CreateOnly"
          },
          {
            "path": "/Presentation",
            "scope": "SingleItem",
            "allowedPushOperations": "CreateOnly"
          },
          {
            "path": "/Settings/Site Grouping",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateOnly"
          },
          {
            "path": "/Settings",
            "scope": "ItemAndChildren",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "*",
            "scope": "Ignored"
          }
        ]
      }
    ]
  }
}
