{
  "$schema": "../../.sitecore/schemas/ModuleFile.schema.json",
  "namespace": "prosperabank",
  "references": [
    "system"
  ],
  "items": {
    "includes": [
      {
        "name": "templates",
        "path": "/sitecore/templates/Project/financial",
        "scope": "ItemAndDescendants", 
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "layout",
        "path": "/sitecore/layout/Renderings/Project/financial",
        "scope": "ItemAndDescendants", 
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "placeholder-settings",
        "path": "/sitecore/layout/Placeholder Settings/Project/Financial",
        "scope": "ItemAndDescendants", 
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "content",
        "path": "/sitecore/content/financial",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "rules": [
          {
            "path": "/guidestone",
            "scope": "ignored"
          },
          {
            "path": "/LogixFederalCreditUnion",
            "scope": "ignored"
          }
        ]
      },
      {
        "name": "media",
        "path": "/sitecore/media library/Project/financial",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "rules": [
          {
            "path": "/guidestone",
            "scope": "ignored"
          },
          {
            "path": "/LogixFederalCreditUnion",
            "scope": "ignored"
          },
          {
            "path": "/Cooley",
            "scope": "ignored"
          },
          {
            "path": "/BrooksRunning",
            "scope": "ignored"
          }
        ]
      },
      {
        "name": "site-template",
        "path": "/sitecore/system/Settings/Project/Prospera Site Template",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "site-template-scripts",
        "path": "/sitecore/system/Modules/PowerShell/Script Library/Prospera Site Template",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      }
    ]
  }
}