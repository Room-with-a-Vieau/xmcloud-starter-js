{
  "$schema": "../../.sitecore/schemas/ModuleFile.schema.json",
  "namespace": "booth-uc",
  "description": "Booth University College demo site. Owns the Education site collection (collection root, its project folders and media). Page and component templates come from the prosperabank module.",
  "references": [
    "system",
    "prosperabank"
  ],
  "items": {
    "includes": [
      {
        "name": "templates",
        "path": "/sitecore/templates/Project/Education",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "branches",
        "path": "/sitecore/templates/Branches/Project/Education",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "layout",
        "path": "/sitecore/layout/Renderings/Project/Education",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "placeholder-settings",
        "path": "/sitecore/layout/Placeholder Settings/Project/Education",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "settings",
        "path": "/sitecore/system/Settings/Project/Education",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "content",
        "path": "/sitecore/content/Education",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "media",
        "path": "/sitecore/media library/Project/Education",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      }
    ]
  }
}
