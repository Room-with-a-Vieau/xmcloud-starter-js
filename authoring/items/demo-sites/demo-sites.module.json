{
  "$schema": "../../.sitecore/schemas/ModuleFile.schema.json",
  "namespace": "demo-sites",
  "description": "Demo Sites collection, holding prospera-demo (collection root, its project folders and media). The site uses Prospera's media under Project/Financial/ProsperaFinancial, which the prosperabank module owns, so restore prosperabank first.",
  "references": [
    "system",
    "prosperabank"
  ],
  "items": {
    "includes": [
      {
        "name": "templates",
        "path": "/sitecore/templates/Project/demo-sites",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "branches",
        "path": "/sitecore/templates/Branches/Project/demo-sites",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "layout",
        "path": "/sitecore/layout/Renderings/Project/demo-sites",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "placeholder-settings",
        "path": "/sitecore/layout/Placeholder Settings/Project/demo-sites",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "settings",
        "path": "/sitecore/system/Settings/Project/demo-sites",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "content",
        "path": "/sitecore/content/demo-sites",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "media",
        "path": "/sitecore/media library/Project/demo-sites",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      }
    ]
  }
}
