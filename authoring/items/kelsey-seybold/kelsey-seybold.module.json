{
  "$schema": "../../.sitecore/schemas/ModuleFile.schema.json",
  "namespace": "kelsey-seybold",
  "description": "Kelsey-Seybold demo site. Owns the healthcare site collection (collection root, its project folders and media) and the Kelsey-Seybold site media, which lives under the Financial media folder. Page and component templates come from the prosperabank module.",
  "references": [
    "system",
    "prosperabank"
  ],
  "items": {
    "includes": [
      {
        "name": "templates",
        "path": "/sitecore/templates/Project/healthcare",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "branches",
        "path": "/sitecore/templates/Branches/Project/healthcare",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "layout",
        "path": "/sitecore/layout/Renderings/Project/healthcare",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "placeholder-settings",
        "path": "/sitecore/layout/Placeholder Settings/Project/healthcare",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "settings",
        "path": "/sitecore/system/Settings/Project/healthcare",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "content",
        "path": "/sitecore/content/healthcare",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "media",
        "path": "/sitecore/media library/Project/healthcare",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      },
      {
        "name": "site-media",
        "path": "/sitecore/media library/Project/Financial/Kelsey-Seybold",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateUpdateAndDelete"
      }
    ]
  }
}
